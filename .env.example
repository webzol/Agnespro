# Agnes AI Studio backend configuration
# Copy this file to .env and fill in the values you want to override.

# HTTP listen address (default: :8080)
AGNES_STUDIO_ADDR=:8080

# Data directory for SQLite DB and generated assets (default: ./data)
AGNES_STUDIO_DATA_DIR=./data

# Optional: pre-provision the Agnes API key. If unset, the user enters
# the key through the Settings page and it is encrypted at rest.
# AGNES_API_KEY=

# Optional: pick a service route. Choices:
#   international  -> https://apihub.agnes-ai.com/v1  (default)
#   international-alt -> https://apihub.agnes-ai.cn/v1
#   china          -> https://api.agnes-ai.cn/v1
AGNES_STUDIO_ROUTE=international

# Master key for encrypting the user-supplied API key at rest. 32 bytes,
# base64 encoded. If left empty, a key is generated and stored in
# data/.masterkey (auto-created on first run).
# AGNES_STUDIO_MASTER_KEY=

# Generation pipeline tuning
AGNES_STUDIO_MAX_CONCURRENCY=1
AGNES_STUDIO_VIDEO_POLL_INTERVAL=5s
AGNES_STUDIO_VIDEO_TIMEOUT=15m
